# LLM (OpenAI-compatible)
# Provider binding behind the common BaseChatModel interface (see ankyra.llm.providers).
# "openai" covers any OpenAI-compatible endpoint; a different SDK is registered there.
ANKYRA_LLM_PROVIDER=openai
ANKYRA_API_URL=https://routerai.ru/api/v1
ANKYRA_API_KEY=
ANKYRA_MODEL=~deepseek/deepseek-v4-flash-latest
ANKYRA_TEMPERATURE=0.1
# Optional per-role override for extract/critic (defaults to ANKYRA_TEMPERATURE).
# An explicit 0 is honoured (checked with is-None, not a falsy or).
# ANKYRA_EXTRACT_TEMPERATURE=0.1
# ANKYRA_CRITIC_TEMPERATURE=0.1
ANKYRA_MAX_TOKENS=4096
# Upper bound for ontology extract; the completion cap scales with source length.
ANKYRA_MAX_TOKENS_EXTRACT=32768
# RouterAI + DeepSeek V4: disable both DeepSeek thinking and RouterAI reasoning budget.
ANKYRA_EXTRA_BODY='{"thinking": {"type": "disabled"}, "reasoning": {"effort": "none"}}'
ANKYRA_REASONING_EFFORT=none

# Reasoning engine
# Narration language (name or ISO code; default en).
# ANKYRA_LANG=en
# ANKYRA_MAX_WAVES=8
# ANKYRA_ALLOW_HYPOTHESES=true
# Enable range-restricted builtin comparisons (eq/neq/lt/lte/gt/gte).
# ANKYRA_BUILTINS=false
# Enable the defeasible (non-monotonic) layer: defaults lose to stricter or more
# specific rules; undecided conflicts stay unknown.
# ANKYRA_DEFEASIBLE=false
# L1 world assumption: open (default) | closed. Closed enables negation-as-failure
# for a query; a benchmark sets it per record, never from the wording.
# ANKYRA_NEGATION_MODE=open
# L2 logic level (off default): off keeps the Horn spine and reports non-Horn
# input out_of_fragment; ground/fol select the bounded-resolution procedure.
# ANKYRA_LOGIC=off
# Resolution step budget for the L2 procedure (default 10000).
# ANKYRA_LOGIC_BUDGET=10000
# Enable the L3 finite-domain CSP engine (off default): a separate engine for
# analytical-reasoning games; without it a CSP structure is out_of_fragment:csp_off.
# ANKYRA_CSP=false
# Search budget (nodes) for the L3 finite-domain solver (default 200000).
# ANKYRA_CSP_BUDGET=200000
# Bounded repair passes for the L3 question encoding when it yields no unique
# verified option (0 disables; default 1).
# ANKYRA_CSP_REPAIRS=1
# Enable the L4 exact-arithmetic engine (off default): a separate engine for numeric
# word problems; without it a numeric structure is out_of_fragment:numeric_off.
# ANKYRA_ARITH=false
# System-size budget for the L4 linear elimination (default 200000).
# ANKYRA_ARITH_BUDGET=200000
# Bounded repair passes for the L4 numeric encoding when it fails to build
# (0 disables; default 2).
# ANKYRA_ARITH_REPAIRS=2
# Best-of-N Phase 0 extraction: sample the model N times and pick the most grounded,
# widest-coverage, most compact structure. 1 keeps the single-call baseline.
# ANKYRA_EXTRACT_SAMPLES=1
# Issue the N extraction samples concurrently (wall-clock only; default true).
# ANKYRA_EXTRACT_PARALLEL=true
# Bounded repair passes over repairable extraction gaps (bad/missing quotes).
# ANKYRA_EXTRACT_REPAIRS=0
# Optional specification of a specialized task-notation language, appended to every
# Phase 0 system prompt (problem/question and CSP game/question). The value is a path
# to a text file (read when it exists) or inline text; empty by default, so prompts are
# unchanged. It documents HOW TO READ the source notation — never per-example answers
# (that would be per-id tuning, docs/task.md §3.8). A collection activates its own file
# via the harness (e.g. evals/skills/ar_lsat/).
# ANKYRA_LANGUAGE_SPEC=
# Optional provider seed (merged into ANKYRA_EXTRA_BODY). Opt-in only: measured to
# be unverified and sometimes more variable with the current router, so not
# recommended. See docs/quality_findings.md C1.
# ANKYRA_SEED=

# Optional separate model slots
# ANKYRA_CRITIC_MODEL=
# ANKYRA_EXTRACT_MODEL=
# ANKYRA_ANSWER_MODEL=
